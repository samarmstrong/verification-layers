-version: 1
-timezone: UTC
-jobs:
-  - id: complete-archive
-    source: mount://
-    strategy:
-      kind: pack
-      options:
-        max_pack_bytes: 32
-    when:
-      kind: daily
-      at: "03:30"
-```
